jobs:
  - job_id: test_imran
    enabled: true
    schedule: "* * * * *"

    source:
      type: local
      path: /Users/imran/sftp_test
      file_pattern: "*.txt"

    destination:
      type: sftp
      path: /root/destination_sftp
      connection:
        host: 82.112.227.158
        port: 22
        username: root
        password: "123456"

    processing:
      enabled: true
      steps: []

    backup:
      enabled: true
      location: /Users/imran/backup
      retention_days: 2

    verification:
      method: size_match
